# ==============================================================================
# Linguaverse Environment Configuration (.env.example)
# ==============================================================================

# 1. GOOGLE AI STUDIO (100% FREE TIER)
# Get your free API key at: https://aistudio.google.com/app/apikey
# Powers all AI writing coaching, grammar feedback, speech evaluation, and embeddings.
# (No Google Cloud billing, GCP project ID, or credit card required!)
GEMINI_API_KEY=your-free-gemini-api-key-here
GOOGLE_API_KEY=your-free-gemini-api-key-here

# 2. SUPABASE (Database, Authentication & Storage)
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. CONTENT ENCRYPTION (AES-256)
# Encrypts sensitive journal entries, notes, and tasks at rest.
ENCRYPTION_KEY=733467698bf3da98db02475044528a720fc11ac89393276d3531cbe0b461b7d9

# 4. WEB PUSH NOTIFICATIONS (VAPID - Optional)
# Used for streak reminders and habit notifications in the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BB7UsJA2YC_BaXhXOdiQlTUyG7BiT3dz5V2JoCXZQh53djwOKMqR8SX6_Ns1zX-i3ZH4_EdW25-TpOz3F20AQss
VAPID_PUBLIC_KEY=BB7UsJA2YC_BaXhXOdiQlTUyG7BiT3dz5V2JoCXZQh53djwOKMqR8SX6_Ns1zX-i3ZH4_EdW25-TpOz3F20AQss
VAPID_PRIVATE_KEY=OVKqmeqzvgysmkmStPb4sC_BFM8BLgkdmmQ3buDbKc4

# 5. GEMINI LIVE AUDIO PROXY (Optional for Duplex Voice)
# Connects to Google AI Studio Generative Language WebSocket. Run: npm run proxy
NEXT_PUBLIC_PROXY_URL=ws://localhost:3001

# 6. APP DEPLOYMENT & SITE URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
