# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BB7UsJA2YC_BaXhXOdiQlTUyG7BiT3dz5V2JoCXZQh53djwOKMqR8SX6_Ns1zX-i3ZH4_EdW25-TpOz3F20AQss
